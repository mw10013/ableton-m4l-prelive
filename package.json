{
  "name": "prelive",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "imports": {
    "#domain/*": "./src/domain/*",
    "#web/*": "./src/web/*",
    "#test/*": "./test/*",
    "#scripts/*": "./scripts/*",
    "#devkit/*": "./vendor/devkit/*",
    "#root/*": "./*"
  },
  "scripts": {
    "dev": "bosun start dev -- env -u FORCE_COLOR NO_COLOR=1 vp dev --clearScreen false",
    "dev:open": "vp run dev && open \"$(bosun status dev | node -p 'JSON.parse(fs.readFileSync(0)).url')\"",
    "dev:stop": "bosun stop dev",
    "dev:status": "bosun status dev",
    "dev:logs": "bosun logs dev",
    "worktree:teardown": "vp run dev:stop",
    "build": "vp build",
    "test": "vp test run",
    "start": "vp preview",
    "clean": "rm -rf node_modules .tanstack",
    "liveql:schema": "vpx scripts/liveql-schema.ts",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.4",
    "@astryxdesign/theme-neutral": "0.7.4",
    "@effect/platform-node": "4.1.0",
    "@stylexjs/stylex": "0.19.1",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.4",
    "effect": "4.1.0",
    "lucide-react": "1.63.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astryxdesign/build": "0.7.4",
    "@astryxdesign/cli": "0.7.4",
    "@babel/core": "8.0.9",
    "@effect/vitest": "4.1.0",
    "@stylexjs/babel-plugin": "0.19.1",
    "@stylexjs/unplugin": "0.19.1",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "catalog:",
    "graphql": "17.0.2",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "2.3.0"
  },
  "browserslist": [
    "chrome >= 123",
    "firefox >= 120",
    "safari >= 17.5"
  ],
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.22.0",
      "onFail": "download"
    }
  },
  "astryx": {
    "theme": "@astryxdesign/theme-neutral"
  }
}
