{
  "name": "prelive",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "imports": {
    "#domain/*": "./src/domain/*",
    "#web/*": "./src/web/*",
    "#scripts/*": "./scripts/*",
    "#root/*": "./*"
  },
  "scripts": {
    "dev": "mkdir -p logs && vp dev 2>&1 | tee logs/server.log",
    "build": "vp build",
    "start": "vp preview",
    "clean": "rm -rf node_modules .tanstack",
    "liveql:schema": "vpx scripts/liveql-schema.ts",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "0.3.0",
    "@astryxdesign/theme-neutral": "0.3.0",
    "@effect/platform-node": "4.0.7",
    "@stylexjs/stylex": "0.19.0",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.4",
    "effect": "4.0.7",
    "lucide-react": "0.562.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@astryxdesign/build": "0.3.0",
    "@astryxdesign/cli": "0.3.0",
    "@babel/core": "^8.0.1",
    "@stylexjs/babel-plugin": "0.19.0",
    "@stylexjs/unplugin": "0.19.0",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@types/node": "^24.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "graphql": "16.14.2",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "browserslist": [
    "chrome >= 123",
    "firefox >= 120",
    "safari >= 17.5"
  ],
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.22.0",
      "onFail": "download"
    }
  },
  "astryx": {
    "theme": "@astryxdesign/theme-neutral"
  }
}
